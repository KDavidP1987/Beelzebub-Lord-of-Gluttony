<Project Sdk="Microsoft.NET.Sdk">
	<!-- DEV-ONLY plugin for the in-game self-test framework (tools/vrclient). Never shipped: it is not in
	     Beelzebub.sln, not in thunderstore.toml, and deploys only to the local dev server. -->
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>DevChatEcho</AssemblyName>
		<RootNamespace>DevChatEcho</RootNamespace>
		<Version>1.0.0</Version>
		<LangVersion>12.0</LangVersion>
		<BepInExPluginGuid>dev.vrclient.ChatEcho</BepInExPluginGuid>
		<BepInExPluginName>DevChatEcho</BepInExPluginName>
		<NuGetAudit>false</NuGetAudit>
		<RestoreSources>$(RestoreSources);https://api.nuget.org/v3/index.json;https://nuget.bepinex.dev/v3/index.json;</RestoreSources>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
		<PackageReference Include="BepInEx.Unity.IL2CPP" Version="[6.0.0-be.733]" />
		<PackageReference Include="VampireReferenceAssemblies" Version="[1.1.12-r99041-b2]" />
		<PackageReference Include="VRising.VampireCommandFramework" Version="0.10.*" />
	</ItemGroup>
	<PropertyGroup>
		<VRisingServerPath Condition="'$(VRisingServerPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\VRisingDedicatedServer</VRisingServerPath>
		<VRisingPluginsPath>$(VRisingServerPath)\BepInEx\plugins</VRisingPluginsPath>
	</PropertyGroup>
	<Target Name="BuildToServer" AfterTargets="Build" Condition="Exists('$(VRisingPluginsPath)')">
		<Copy SourceFiles="$(TargetDir)$(ProjectName).dll" DestinationFolder="$(VRisingPluginsPath)" />
	</Target>
</Project>
