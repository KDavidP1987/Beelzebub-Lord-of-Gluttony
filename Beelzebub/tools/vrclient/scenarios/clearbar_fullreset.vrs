# clearbar_fullreset.vrs — dod clearbar-fullreset D12 (v0.137.4): every `.beelz clearbar <set>` runs the layered reset
# (scope=ClearSet) and ends clean; a kept set's binds come back; a rider is dismounted and a transform ended, and the
# reply says so. Cases: (a) universal, (b) sword, (e) sword with a universal bind kept, (f) universal while transformed,
# (c) wolf while in a live wolf form, (d) all while riding.
# Needs: Chaos holds a sword; captured 1621601748 (Knife Throw); transform unlock Beatrice (named, not indexed); VerboseLogging for casts.
ensure
console TPHome
wait 3
chat .beelz admin set VerboseLogging true
expect-reply VerboseLogging
chat .beelz resetbar CONFIRM
expect-log \[Beelz RESET\].*target=${CHARACTER} .*clean=1
# --- (a) universal ---
chat .beelz grant 1 1621601748
expect-reply Slot 1 assigned
wait 2
chat .beelz clearbar universal
expect-log \[Beelz RESET\].*scope=ClearSet set=universal target=${CHARACTER} .*clean=1
expect-reply Cleared your universal loadout
# --- (b) sword ---
chat .beelz weapon-grant sword 4 1621601748
expect-reply sword
wait 2
chat .beelz clearbar sword
expect-log \[Beelz RESET\].*scope=ClearSet set=weapon:Sword target=${CHARACTER} .*clean=1
expect-reply Cleared your Sword loadout
# --- (e) sword cleared, universal bind on Q kept and castable ---
chat .beelz grant 1 1621601748
expect-reply Slot 1 assigned
chat .beelz weapon-grant sword 4 1621601748
expect-reply sword
wait 2
chat .beelz clearbar sword
expect-log \[Beelz RESET\].*scope=ClearSet set=weapon:Sword target=${CHARACTER} .*RestoreKept:[1-9].*clean=1
chat .beelz admin bar ${CHARACTER}
expect-log \[Beelz BAR\].*target=${CHARACTER} .*slots=(.*,)?1:bind:
wait 2
cast q 0.15 0
expect-log \[Beelz SUMMON\]\[cast\].*guid=1621601748 timeout=8
wait 3
# --- (f) universal while transformed (Beatrice) ---
chat .beelz transform Beatrice
expect-reply Transformed into Beatrice
wait 3
shot full transformed
chat .beelz clearbar universal
expect-log \[Beelz RESET\].*scope=ClearSet set=universal target=${CHARACTER} .*RevertTransform:1.*clean=1
expect-reply Your transform was ended to clear the bar.
wait 3
# --- (c) wolf while in a live wolf form ---
chat .beelz form-grant wolf 1 1621601748
expect-reply Wolf slot 1
chat .beelz admin testform wolf
expect-log action=testform.*form=wolf timeout=8
expect-reply Now in Wolf form
wait 3
shot full wolf-form
chat .beelz clearbar wolf
expect-log \[Beelz RESET\].*scope=ClearSet set=form:Wolf target=${CHARACTER} .*clean=1
expect-reply Your transform was ended to clear the bar.
wait 3
# --- (d) all, while riding with a saddle bind on R ---
chat .beelz admin testmount on ${CHARACTER}
expect-log action=testmount.*on ok=True
chat .beelz form-grant mounted 5 1621601748
expect-reply Mounted slot 5
expect-screen Hold to Mount timeout=8
hold f 2.5
expect-log saddle loadout injected on slot\(s\) \[5\] timeout=10
wait 2
chat .beelz clearbar all
expect-log \[Beelz DISMOUNT\].*issued=True
expect-log \[Beelz RESET\].*scope=ClearSet set=all target=${CHARACTER} .*Dismount:1.*clean=1
expect-reply You were dismounted to reset your bar; remount to ride.
wait 2
shot spells after-clearbar-all-mounted
chat .beelz admin bar ${CHARACTER}
expect-log \[Beelz BAR\].*target=${CHARACTER} .*binds=0 rows=0 .*other=0
# cleanup
chat .beelz admin testmount off ${CHARACTER}
expect-log action=testmount.*off
chat .beelz resetbar CONFIRM
expect-log \[Beelz RESET\].*target=${CHARACTER} .*clean=1
