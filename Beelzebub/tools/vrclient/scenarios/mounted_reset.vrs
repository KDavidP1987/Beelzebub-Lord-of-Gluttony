# mounted_reset.vrs — mounted-bar-reset (v0.137.3) regression: saddle bind on R, a reset while riding dismounts and
# says so, the mount buff is destroyed once. Needs: Chaos holds a sword and has captured 1621601748 (Knife Throw).
ensure
# every scenario starts from a known, safe spot (the castle) - a runaway keystroke can walk the character off
console TPHome
wait 3
chat .beelz resetbar CONFIRM
expect-log \[Beelz RESET\].*target=${CHARACTER} .*clean=1
chat .beelz admin testmount on ${CHARACTER}
expect-log \[Beelz AUDIT\].*action=testmount.*on ok=True
chat .beelz form-grant mounted 5 1621601748
expect-reply Mounted slot 5 = AB_Undead_Infiltrator_KnifeThrow_AbilityGroup
expect-chat Mounted slot 5 = AB_Undead_Infiltrator_KnifeThrow
# the horse spawns next to the character; the game shows the mount prompt, then hold the interact key
expect-screen Hold to Mount timeout=8
hold f 2.5
expect-log saddle loadout injected on slot\(s\) \[5\] timeout=10
wait 2
shot spells mounted-bar
chat .beelz resetbar CONFIRM
expect-log \[Beelz DISMOUNT\].*issued=True
expect-log \[Beelz RESET\].*Dismount:1,ClearEquipEntries:0,DestroyOverrideSources:0.*clean=1
expect-reply You were dismounted to reset your bar; remount to ride.
expect-chat You were dismounted to reset your bar; remount to ride.
expect-no-log resetbar: destroyed owned ability-slot source AB_Interact_Mount_Owner_Buff timeout=2
chat .beelz admin testmount off ${CHARACTER}
expect-log action=testmount.*off horses=1
chat .beelz resetbar CONFIRM
expect-log \[Beelz BAR\].*target=${CHARACTER} .*binds=0 rows=0 .*other=0
