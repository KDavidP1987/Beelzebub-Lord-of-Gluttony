<Project Sdk="Microsoft.NET.Sdk">
	<!-- v0.133.0: logic-only tests. LINKS the plugin's pure Logic/*.cs (no IL2CPP / game references), so the
	     exact code the plugin ships is what runs here. Run: dotnet test Beelzebub.Tests -->
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>12.0</LangVersion>
		<IsPackable>false</IsPackable>
		<NuGetAudit>false</NuGetAudit>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="..\Beelzebub\Logic\*.cs" Link="Logic\%(Filename)%(Extension)" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
		<PackageReference Include="xunit" Version="2.5.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
	</ItemGroup>
</Project>
